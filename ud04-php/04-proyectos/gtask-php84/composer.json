{
  "name": "dwes/gtask-starter",
  "description": "Incremental secure PHP 8.4 exercise starter",
  "license": "proprietary",
  "type": "project",
  "require": {
    "php": "^8.4",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_sqlite": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "GTask\\": "src/"
    },
    "files": [
      "src/Http/Escape.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "GTask\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --exclude-group checkpoint",
    "checkpoint": "phpunit"
  }
}
